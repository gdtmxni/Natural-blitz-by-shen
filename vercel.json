{
  "cleanUrls": true,
  "redirects": [
    { "source": "/lib/:path*", "destination": "/", "permanent": false },
    { "source": "/server/:path*", "destination": "/", "permanent": false }
  ],
  "headers": [
    { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "Cache-Control", "value": "no-store" }] }
  ]
}
