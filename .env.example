# Copy to .env.local for local testing. On Vercel, add these under Project > Settings > Environment Variables.
# Nothing here is required to try the site locally except the two admin values.

# --- Admin dashboard login (required) ---
ADMIN_PASSWORD=choose-a-long-password
ADMIN_SECRET=any-random-string-of-at-least-32-characters

# --- Where Shen's new-booking alerts go ---
ADMIN_EMAIL=zemgrafix@gmail.com          # testing; switch to Shen's email at launch
ADMIN_WHATSAPP=                          # e.g. 8765550123 (a test number while testing)

# --- Email sending (Resend). Without a key, emails are only logged in the dashboard ---
RESEND_API_KEY=
EMAIL_FROM=Natural Blitz by Shen <onboarding@resend.dev>

# --- Texts / WhatsApp (Twilio). Without these, texts are only logged in the dashboard ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
CUSTOMER_CHANNEL=sms                     # sms or whatsapp

# --- Database (Upstash Redis from the Vercel Marketplace). Without it, data is saved in .data/ locally ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Other ---
BANK_DETAILS=                            # e.g. Scotiabank · Account name · Account number · Branch
SITE_URL=https://natural-blitz-by-shen.vercel.app
CRON_SECRET=                             # protects /api/cron/reminders
